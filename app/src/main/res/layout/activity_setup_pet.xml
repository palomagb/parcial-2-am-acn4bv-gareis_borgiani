<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:padding="24dp"
    tools:context=".SetupPetActivity">

    <TextView
        android:id="@+id/textTituloSetup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Te damos la bienvenida!"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/textSubtituloSetup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contanos sobre tu compañero de aventuras"
        android:textColor="#666666"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/textTituloSetup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- nombre -->
    <EditText
        android:id="@+id/editNombreMascota"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre de la mascota (Ej: Polar)"
        android:inputType="textCapWords"
        android:background="@drawable/border_history"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textSubtituloSetup"
        android:layout_marginTop="40dp"/>

    <!-- especie -->
    <EditText
        android:id="@+id/editEspecie"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Especie (Ej: Gato, Perro)"
        android:inputType="textCapWords"
        android:drawableStart="@drawable/ic_especie"
        android:drawablePadding="12dp"
        android:background="@drawable/border_history"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/editNombreMascota"
        android:layout_marginTop="16dp"/>

    <!-- edad -->
    <EditText
        android:id="@+id/editEdad"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Edad (en años)"
        android:inputType="number"
        android:drawableStart="@drawable/ic_edad"
        android:drawablePadding="12dp"
        android:background="@drawable/border_history"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/editEspecie"
        android:layout_marginTop="16dp"/>

    <!-- peso -->
    <EditText
        android:id="@+id/editPeso"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Peso (en kg)"
        android:inputType="numberDecimal"
        android:drawableStart="@drawable/ic_peso"
        android:drawablePadding="12dp"
        android:background="@drawable/border_history"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/editEdad"
        android:layout_marginTop="16dp"/>

    <ProgressBar
        android:id="@+id/barraProgresoSetup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/editPeso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- bot guardar -->
    <Button
        android:id="@+id/botonGuardarMascota"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Guardar y Empezar"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:backgroundTint="#A8D5BA"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>